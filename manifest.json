{
  "manifest_version": 3,
  "key": "",
  "name": "English in Everything",
  "version": "1.33.0",
  "description": "Khóa trình duyệt tới khi bạn học xong: từ vựng lặp ngắt quãng, ngữ pháp, câu IELTS. Kèm dịch PDF/web và tra từ bằng AI.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "scripting",
    "contextMenus",
    "activeTab",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "English in Everything",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Mở side panel (dịch / học)"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Dịch nhanh đoạn đang bôi đen"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "gate.html",
        "gate.css",
        "gate.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
